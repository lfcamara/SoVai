{
  "description": "SoVai enforcement layer: SessionStart orchestration mandate + skill index, pre-edit TDD/UI gate, TDD phase tracking, TDD stop-gate. Every command is plugin-relative via ${CLAUDE_PLUGIN_ROOT}; path classification comes from the edited project's sovai.config.json, never from this plugin.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/sovai-session-bootstrap.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/sovai-pre-edit-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tdd-phase-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tdd-stop-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
